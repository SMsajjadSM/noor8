# GitHub (server only; fine-grained token, Contents: read/write on this repo only)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_MAIN_BRANCH=main
GITHUB_DRAFT_BRANCH=content-drafts

# Admin (single user)
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=   # at least 32 random characters

NEXT_PUBLIC_SITE_URL=https://noor8shop.ir
# Set to true on test/staging deployments so search engines ignore them. Remove for the real domain.
SITE_NOINDEX=true
